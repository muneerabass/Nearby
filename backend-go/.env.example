# Locally, provide either :3000 or 3000. On Cloud Run, omit this and use the
# PORT supplied by the platform.
HTTP_PORT=:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickcommerce?sslmode=disable
# Pool defaults: 10 max connections per Cloud Run instance, 5 idle. With
# max-instances=3 this reserves up to ~30 application connections, leaving
# headroom for migrations/admin tools within the Cloud SQL connection limit.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-separate-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
OTP_RESEND_AFTER=60s
OTP_MAX_ATTEMPTS=5

# Order pricing rules (all monetary values are paise). Set to 0 to disable the
# minimum order rule. Totals are always recalculated by the backend.
MINIMUM_ORDER_VALUE=0
DELIVERY_FEE=2500
HANDLING_FEE=400
FREE_DELIVERY_THRESHOLD=19900

# Local dev: enables [DEV OTP] stdout logging and GET /api/v1/auth/dev/last-otp.
# Must be false in production.
DEV_OTP_LOG=true

# Phone to be upgraded to admin on first OTP verify.
ADMIN_PHONE=+919999999999

# Optional: real OTP delivery (leave empty in dev when DEV_OTP_LOG=true).
TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE=OTP1
TWO_FACTOR_BASE_URL=https://2factor.in

# Optional: geocoding for user addresses.
GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com

# Cloudinary signed uploads (admin only). All three required to enable the
# POST /api/v1/admin/uploads/signature endpoint. Leave empty to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# HMAC key for delivery completion codes. Must differ from JWT_SECRET in production.
DELIVERY_CODE_SECRET=replace-with-a-separate-random-secret

# Comma-separated list of allowed CORS origins. Required in production.
# e.g. https://your-app.com,https://admin.your-app.com
ALLOWED_ORIGINS=
